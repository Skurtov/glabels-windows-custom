+        ///
+        /// Record filter: a row is shown when every whitespace-separated term of the
+        /// filter text is found (case-insensitively) in at least one of its columns.
+        ///
+        class MergeFilterProxyModel : public QSortFilterProxyModel
+        {
+        public:
+                MergeFilterProxyModel( QObject* parent = nullptr )
+                        : QSortFilterProxyModel( parent )
+                {
+                }
+
+                void setFilterText( const QString& text )
+                {
+                        static const QRegularExpression whitespace( "\\s+" );
+                mTerms = text.split( whitespace, Qt::SkipEmptyParts );
+                        invalidateFilter();
+                }
+
+                bool isActive() const
+                {
+                        return !mTerms.isEmpty();
+                }
+
+        protected:
+                bool filterAcceptsRow( int sourceRow, const QModelIndex& sourceParent ) const override
+                {
+                        for ( const auto& term : mTerms )
+                        {
+                                bool found = false;
+                                for ( int col = 0; col < sourceModel()->columnCount( sourceParent ); col++ )
+                                {
+                                        auto index = sourceModel()->index( sourceRow, col, sourceParent );
+                                        if ( sourceModel()->data( index, Qt::DisplayRole ).toString().contains( term, Qt::CaseInsensitive ) )
+                                        {
+                                                found = true;
+                                                break;
+                                        }
+                                }
+                                if ( !found )
+                                {
+                                        return false;
+                                }
+                        }
+                        return true;
+                }
+
+        private:
+                QStringList mTerms;
+        };
+
