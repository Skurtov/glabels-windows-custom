+        ///
+        /// Set selection state of several records at once (emits selectionChanged() only once)
+        ///
+        void Merge::setSelectedRecords( const QList<int>& rows, bool state )
+        {
+                for ( int i : rows )
+                {
+                        if ( (i >= 0) && (i < mRecordList.size()) )
+                        {
+                                mRecordList[i].setSelected( state );
+                        }
+                }
+                emit selectionChanged();
+        }
+
+
         ///
         /// Select all records
         ///
