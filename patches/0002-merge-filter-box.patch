+        ///
+        /// (Re)build the records table: merge records -> filter -> view
+        ///
+        void MergeView::resetRecordsTable()
+        {
+                auto* oldFilterModel = mFilterModel;
+                auto* oldTableModel  = mTableModel;
+
+                mTableModel  = new MergeTableModel( mModel->merge(), this );
+                mFilterModel = new MergeFilterProxyModel( this );
+                mFilterModel->setSourceModel( mTableModel );
+                mFilterModel->setFilterText( filterLineEdit->text() );
+
+                recordsTableView->setModel( mFilterModel );
                 recordsTableView->resizeColumnsToContents();
+
+                // Only release the previous models once the view no longer uses them
+                delete oldFilterModel;
+                delete oldTableModel;
+
+                updateFilterCount();
+        }
+
+
+        ///
+        /// Update the record counter next to the filter box.
+        ///
+        /// The selected count is always shown: records hidden by the filter stay
+        /// selected (and are printed), and all records start out selected.
+        ///
+        void MergeView::updateFilterCount()
+        {
+                if ( !mModel || !mFilterModel )
+                {
+                        filterCountLabel->setText( "" );
+                        return;
+                }
+
+                int nRecords  = mFilterModel->sourceModel()->rowCount();
+                int nSelected = mModel->merge()->nSelectedRecords();
+
+                if ( nRecords == 0 )
+                {
+                        filterCountLabel->setText( "" );
+                }
+                else if ( mFilterModel->isActive() )
+                {
+                        filterCountLabel->setText( tr("%1 of %2 shown, %3 selected")
+                                                   .arg( mFilterModel->rowCount() )
+                                                   .arg( nRecords )
+                                                   .arg( nSelected ) );
+                }
+                else
+                {
+                        filterCountLabel->setText( tr("%1 of %2 selected")
+                                                   .arg( nSelected )
+                                                   .arg( nRecords ) );
+                }
+        }
+
+
+        ///
+        /// Source row numbers of the records that pass the current filter
+        ///
+        QList<int> MergeView::shownSourceRows() const
+        {
+                QList<int> rows;
+
+                if ( !mFilterModel )
+                {
+                        return rows;
+                }
+
+                for ( int i = 0; i < mFilterModel->rowCount(); i++ )
+                {
+                        rows.push_back( mFilterModel->mapToSource( mFilterModel->index( i, 0 ) ).row() );
+                }
+
+                return rows;
+        }
+
+
+        ///
+        /// Filter text changed handler
+        ///
+        void MergeView::onFilterTextChanged()
+        {
+                if ( !mFilterModel )
+                {
+                        return;
+                }
+
+                mFilterModel->setFilterText( filterLineEdit->text() );
+                updateFilterCount();
         }
 
 
