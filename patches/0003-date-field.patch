+        ///
+        /// "@format": a Qt date/time format.  It runs to the closing '}' so that it can
+        /// contain ':' (e.g. "hh:mm"); a literal '}' or '\' is written as "\}" or "\\".
+        ///
+        bool SubstitutionField::parseDateFormatModifier( ParserState& s, SubstitutionField& field )
+        {
+                field.mDateFormat.clear();
+
+                while ( s.charsLeft() && s[0] != '}' )
+                {
+                        if ( s[0] == '\\' )
+                        {
+                                s.advanceChars( 1 ); // Skip escape
+                                if ( s.charsLeft() )
+                                {
+                                        field.mDateFormat.append( s[0] );
+                                        s.advanceChars( 1 );
+                                }
+                        }
+                        else
+                        {
+                                field.mDateFormat.append( s[0] );
+                                s.advanceChars( 1 );
+                        }
+                }
+
+                return true;
+        }
+
+
+        ///
+        /// "+N" / "-N", optionally followed by a unit: d (days, default), w, m or y.
+        ///
+        bool SubstitutionField::parseDateOffsetModifier( ParserState& s, SubstitutionField& field )
+        {
+                int sign = (s[0] == '-') ? -1 : 1;
+                s.advanceChars( 1 );
+
+                QString digits;
+                while ( s.charsLeft() && s[0].isDigit() && digits.size() < 6 )
+                {
+                        digits.append( s[0] );
+                        s.advanceChars( 1 );
+                }
+                if ( digits.isEmpty() )
+                {
+                        return false;
+                }
+
+                QChar unit = 'd';
+                if ( s.charsLeft() && QString( "dwmy" ).contains( s[0] ) )
+                {
+                        unit = s[0];
+                        s.advanceChars( 1 );
+                }
+
+                field.mDateOffsets.append( { sign * digits.toInt(), unit } );
+                return true;
+        }
+
