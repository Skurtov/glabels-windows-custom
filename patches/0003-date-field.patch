+        QString SubstitutionField::formatDate( const QDateTime& now ) const
+        {
+                QDateTime dateTime = now;
+
+                for ( const auto& offset : mDateOffsets )
+                {
+                        switch ( offset.unit.unicode() )
+                        {
+                        case 'w':
+                                dateTime = dateTime.addDays( 7LL * offset.amount );
+                                break;
+                        case 'm':
+                                dateTime = dateTime.addMonths( offset.amount );
+                                break;
+                        case 'y':
+                                dateTime = dateTime.addYears( offset.amount );
+                                break;
+                        default:
+                                dateTime = dateTime.addDays( offset.amount );
+                                break;
+                        }
+                }
+
+                QLocale locale;
+                if ( mDateFormat.isEmpty() )
+                {
+                        return locale.toString( dateTime.date(), QLocale::ShortFormat );
+                }
+                return locale.toString( dateTime, mDateFormat );
+        }
