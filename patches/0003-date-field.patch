+void TestSubstitutionField::dateParse()
+{
+        using namespace glabels;
+
+        model::SubstitutionField f1( "${DATE}" );
+        QCOMPARE( f1.fieldName(),  QString( "DATE" ) );
+        QCOMPARE( f1.dateFormat(), QString( "" ) );
+
+        // Format runs to the closing brace, so it may contain ':'
+        QString input2 = "${DATE:@yyyy-MM-dd hh:mm}rest";
+        model::ParserState s2( input2 );
+        model::SubstitutionField f2;
+        QCOMPARE( model::SubstitutionField::parse( s2, f2 ), true );
+        QCOMPARE( f2.fieldName(),  QString( "DATE" ) );
+        QCOMPARE( f2.dateFormat(), QString( "yyyy-MM-dd hh:mm" ) );
+        QCOMPARE( s2.pos(), int( QString( "${DATE:@yyyy-MM-dd hh:mm}" ).size() ) );
+
+        // Escapes
+        model::SubstitutionField f3( "${DATE:@'{'\\}\\\\}" );
+        QCOMPARE( f3.dateFormat(), QString( "'{'}\\" ) );
+
+        // Offsets and other modifiers combine
+        QString input4 = "${DATE:n:+30:-2w:+1m:+1y:@yyyy}";
+        model::ParserState s4( input4 );
+        model::SubstitutionField f4;
+        QCOMPARE( model::SubstitutionField::parse( s4, f4 ), true );
+        QCOMPARE( f4.newLine(),    true );
+        QCOMPARE( f4.dateFormat(), QString( "yyyy" ) );
+
+        // Invalid: these are not parsed as fields and do not advance the parser
+        const QStringList invalid = { "${DATE:+}", "${DATE:-x}", "${DATE:+3q}", "${DATE:@yyyy", "${DATE:+1234567}" };
+        for ( const auto& input : invalid )
+        {
+                model::ParserState s( input );
+                model::SubstitutionField f;
+                QVERIFY2( !model::SubstitutionField::parse( s, f ), qPrintable( input ) );
+                QCOMPARE( s.pos(), 0 );
+        }
+}
+
+
+void TestSubstitutionField::dateEvaluation()
+{
+        using namespace glabels;
+
+        merge::Record   noRecord;
+        model::Variables noVariables;
+
+        // Evaluate a field and compute the expected value from the same date.  If the date
+        // rolls over in between (midnight), try again.
+        auto check = [&]( const QString& text, auto expectedFor )
+        {
+                model::SubstitutionField field( text );
+                for ( int attempt = 0; attempt < 3; attempt++ )
+                {
+                        QDate before = QDate::currentDate();
+                        QString actual = field.evaluate( noRecord, noVariables );
+                        if ( QDate::currentDate() == before )
+                        {
+                                QCOMPARE( actual, QString( expectedFor( before ) ) );
+                                return;
+                        }
+                }
+                QFAIL( "date kept changing" );
+        };
+
+        QLocale locale;
+
+        check( "${DATE}", [&]( QDate d ) { return locale.toString( d, QLocale::ShortFormat ); } );
+        check( "${DATE:@yyyy-MM-dd}", []( QDate d ) { return d.toString( "yyyy-MM-dd" ); } );
+        check( "${DATE:@dd/MM/yyyy}", []( QDate d ) { return d.toString( "dd/MM/yyyy" ); } );
+        check( "${DATE:@'Printed' d MMM yyyy}", [&]( QDate d ) { return locale.toString( d, "'Printed' d MMM yyyy" ); } );
+        check( "${DATE:+30:@yyyy-MM-dd}", []( QDate d ) { return d.addDays( 30 ).toString( "yyyy-MM-dd" ); } );
+        check( "${DATE:-1:@yyyy-MM-dd}",  []( QDate d ) { return d.addDays( -1 ).toString( "yyyy-MM-dd" ); } );
+        check( "${DATE:+2w:@yyyy-MM-dd}", []( QDate d ) { return d.addDays( 14 ).toString( "yyyy-MM-dd" ); } );
+        check( "${DATE:+6m:@yyyy-MM-dd}", []( QDate d ) { return d.addMonths( 6 ).toString( "yyyy-MM-dd" ); } );
+        check( "${DATE:-1y:@yyyy-MM-dd}", []( QDate d ) { return d.addYears( -1 ).toString( "yyyy-MM-dd" ); } );
+        check( "${DATE:+1y:+1m:+1:@yyyy-MM-dd}", []( QDate d ) { return d.addYears( 1 ).addMonths( 1 ).addDays( 1 ).toString( "yyyy-MM-dd" ); } );
+        check( "${DATE:n:@yyyy}", []( QDate d ) { return "\n" + d.toString( "yyyy" ); } );
+
+        // Time tokens are allowed; just check the shape
+        QString withTime = model::SubstitutionField( "${DATE:@hh:mm}" ).evaluate( noRecord, noVariables );
+        QVERIFY2( QRegularExpression( "^\\d\\d:\\d\\d$" ).match( withTime ).hasMatch(), qPrintable( withTime ) );
+
+        // A merge field or variable named DATE takes precedence over the built-in date
+        merge::Record record;
+        record[ "DATE" ] = "from merge";
+        QCOMPARE( model::SubstitutionField( "${DATE:@yyyy}" ).evaluate( record, noVariables ), QString( "from merge" ) );
+
+        model::Variables variables;
+        variables.addVariable( model::Variable( model::Variable::Type::STRING, "DATE", "from variable" ) );
+        QCOMPARE( model::SubstitutionField( "${DATE:@yyyy}" ).evaluate( noRecord, variables ), QString( "from variable" ) );
+
+        // An empty merge field falls back to the built-in date
+        merge::Record emptyDate;
+        emptyDate[ "DATE" ] = "";
+        QCOMPARE( model::SubstitutionField( "${DATE:@yyyy}" ).evaluate( emptyDate, noVariables ),
+                  QString::number( QDate::currentDate().year() ) );
+
+        // Date modifiers have no effect on other fields, and other names are not dates
+        merge::Record other;
+        other[ "x" ] = "abc";
+        QCOMPARE( model::SubstitutionField( "${x:+30:@yyyy}" ).evaluate( other, noVariables ), QString( "abc" ) );
+        QCOMPARE( model::SubstitutionField( "${date}" ).evaluate( noRecord, noVariables ), QString( "" ) );
+        QCOMPARE( model::SubstitutionField( "${Date:=none}" ).evaluate( noRecord, noVariables ), QString( "none" ) );
+}
